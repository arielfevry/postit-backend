PORT=5000
MONGODB_URI=mongodb://localhost:27017/PostItDB
CORS_ORIGIN=http://localhost:5173
# Enable for local POST-to-worker tests; mock mode never sends messages.
REMINDER_WORKER_ENABLED=false
REMINDER_DELIVERY_MODE=mock
REMINDER_POLL_INTERVAL_MS=5000
REMINDER_LEASE_MS=60000
REMINDER_PROVIDER_TIMEOUT_MS=10000
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_BASE_MS=30000
REMINDER_BATCH_SIZE=20
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Required for JWT login and authenticated Reminder requests. No fallback secret.
# Set a private random secret of at least 32 bytes in your actual .env.
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=postit-backend
JWT_AUDIENCE=postit-api
